function buildTradeDigitalRows(){
  const rows=[];
  REAL_TRADE_ACTIONS.forEach(a=>{
    const produto = a.produtos.length ? a.produtos.map(p=>PRODUTO_LABEL[p]||p).join(', ') : 'Portfólio Condres';
    Object.entries(a.monthly).forEach(([mes,valor])=>{
      if(valor>0) rows.push({mes, parceiro:a.parceiro, produto, acao:a.acao, valor:Math.round(valor), objetivo:a.objetivo});
    });
  });
  return rows;
}
const TRADE_ROWS = buildTradeDigitalRows();

function buildTradeAccordion(){
  const wrap = document.getElementById('tradeAccordion'); wrap.innerHTML='';
  Object.keys(DATA.tradeDigitalMonthly).forEach((mes,idx)=>{
    const total = DATA.tradeDigitalMonthly[mes];
    const rows = TRADE_ROWS.filter(r=>r.mes===mes);
    const isPeak = mes==='Mai/26';
    const item = document.createElement('div'); item.className='accordion-item';
    item.innerHTML = `
      <h2 class="accordion-header">
        <button class="accordion-button ${idx>0?'collapsed':''}" type="button" data-bs-toggle="collapse" data-bs-target="#coll-${idx}">
          <span style="flex:1;">${mes}${isPeak?' <span class="badge-confirmed" style="margin-left:8px;">pico do período</span>':''}</span>
          <span style="font-family:'Sora',sans-serif; font-weight:700; margin-right:14px;">${fmtBRL(total)}</span>
        </button>
      </h2>
      <div id="coll-${idx}" class="accordion-collapse collapse ${idx===0?'show':''}" data-bs-parent="#tradeAccordion">
        <div class="accordion-body">
          <table class="table table-sm table-hover mb-0">
            <thead><tr><th>Parceiro</th><th>Produto</th><th>Ação</th><th class="text-end">Investimento</th></tr></thead>
            <tbody>
              ${rows.map((r,ri)=>`<tr style="cursor:pointer;" onclick="openActionModal('${mes}','${r.parceiro}',${ri})"><td>${r.parceiro}</td><td>${r.produto}</td><td>${r.acao} ▸</td><td class="text-end">${fmtBRL(r.valor)}</td></tr>`).join('')}
            </tbody>
          </table>
        </div>
      </div>`;
    wrap.appendChild(item);
  });
}

function openActionModal(mes, parceiro, rowIdx){
  const rows = TRADE_ROWS.filter(r=>r.mes===mes);
  const clicked = rows[rowIdx];
  const group = TRADE_ROWS.filter(r=>r.mes===mes && r.parceiro===parceiro && r.acao===clicked.acao);
  const produtos = [...new Set(group.map(g=>g.produto))];
  const totalValor = group.reduce((a,b)=>a+b.valor,0);
  document.getElementById('actionModalTitle').textContent = clicked.acao;
  document.getElementById('actionModalBody').innerHTML = `
    <div class="stat-row"><span>Parceiro</span><span>${parceiro}</span></div>
    <div class="stat-row"><span>Investimento</span><span>${fmtBRL(totalValor)}</span></div>
    <div class="stat-row"><span>Período</span><span>${mes}</span></div>
    <div class="mini-label">Produtos</div>
    <p class="mini-text">${produtos.map(p=>'• '+p).join('<br>')}</p>
    <div class="mini-label">Objetivo</div>
    <p class="mini-text">${clicked.objetivo}</p>
    <span class="badge-confirmed">valor real — Mídia_-_Trade.xlsx, aba TRADE</span>
    <hr>
    <button class="btn btn-outline-navy btn-sm" onclick="toggleImpact('${mes}','${produtos.join('|')}')">▸ Ver Impacto</button>
    <div id="impactBox" style="display:none; margin-top:14px;"></div>`;
  new bootstrap.Modal(document.getElementById('actionModal')).show();
}

function toggleImpact(mes, produtosStr){
  const box = document.getElementById('impactBox');
  if(box.style.display==='block'){ box.style.display='none'; return; }
  const produtos = produtosStr.split('|').filter(p=>PRODUCTS.includes(p));
  const idx = MONTH_ORDER.indexOf(mes);
  const before = MONTH_ORDER[idx-1], after = MONTH_ORDER[idx+1];
  function sumFor(m){ return produtos.reduce((a,p)=> a + ((DATA.produtoVendasMensais[p]||{})[m]||0), 0); }
  const vAntes = sumFor(before), vDurante = sumFor(mes), vDepois = sumFor(after||mes);
  const growth = vAntes>0 ? (((vDepois-vAntes)/vAntes)*100).toFixed(0) : '—';
  box.innerHTML = produtos.length ? `
    <div class="stat-row"><span>Vendas antes (${before||'-'})</span><span>R$ ${vAntes.toFixed(2)} MM</span></div>
    <div class="stat-row"><span>Vendas durante (${mes})</span><span>R$ ${vDurante.toFixed(2)} MM</span></div>
    <div class="stat-row"><span>Vendas depois (${after||'-'})</span><span>R$ ${vDepois.toFixed(2)} MM</span></div>
    <div class="insight-box">Após esta ação foi observado ${growth>=0?'crescimento':'variação'} de <b>${growth>0?'+':''}${growth}%</b> nas vendas do(s) produto(s) envolvido(s). <span class="badge-est">vendas mensais ainda estimadas — não enviadas nos arquivos</span></div>` :
    `<div class="insight-box">Ação de portfólio (não associada a um produto específico) — sem série de vendas dedicada para comparar. <span class="badge-est">vendas por produto ainda estimadas</span></div>`;
  box.style.display='block';
}

function buildTradeVsVendasChart(){
  const labels = Object.keys(DATA.tradeDigitalMonthly);
  const invest = labels.map(m=>DATA.tradeDigitalMonthly[m]/1000);
  const vendas = labels.map(m=> (DATA.produtoVendasMensais['Condres AH'][m]+DATA.produtoVendasMensais['Condres Longbio'][m]+DATA.produtoVendasMensais['Condres Force'][m]) );
  const peakIdx = labels.indexOf('Mai/26');
  new Chart(document.getElementById('chartTradeVsVendas'), {
    data:{labels, datasets:[
      {type:'bar', label:'Investimento Trade (R$ mil)', data:invest, backgroundColor:labels.map((_,i)=>i===peakIdx?'#00875A':'#00A3A3'), yAxisID:'y'},
      {type:'line', label:'Vendas grupo investido (R$ MM, estimado)', data:vendas, borderColor:'#003366', backgroundColor:'#003366', borderWidth:2.5, pointRadius:4, yAxisID:'y1'}
    ]},
    options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'top', labels:{boxWidth:11, font:{size:10.5}}}}, scales:{y:{title:{display:true,text:'R$ mil'}, grid:{color:'#EEF2F6'}}, y1:{position:'right', grid:{display:false}, title:{display:true,text:'R$ MM'}}}}
  });
  const idx = labels.indexOf('Mai/26');
  const vAntes = vendas[idx-1], vDepois = vendas[idx+1]!==undefined?vendas[idx+1]:vendas[idx];
  const growth = (((vDepois-vAntes)/vAntes)*100).toFixed(0);
  document.getElementById('tradePicoInsight').innerHTML = `<b>Interpretação automática:</b> o pico de investimento ocorreu em maio de 2026 (${fmtBRL(DATA.tradeDigitalMonthly['Mai/26'])} — <span class="badge-confirmed" style="font-size:10px;">confirmado</span>) e coincidiu com aceleração de ${growth>0?'+':''}${growth}% nas vendas dos produtos investidos entre os meses vizinhos, sugerindo associação positiva entre investimento e resultado. <span class="badge-est">vendas mensais ainda estimadas</span>`;
}

/* ---------- Auditoria completa (DataTable + export) ---------- */
let auditTableInited = false;
document.getElementById('auditModal').addEventListener('shown.bs.modal', ()=>{
  if(auditTableInited) return;
  auditTableInited = true;
  const tbody=document.querySelector('#tableAudit tbody'); tbody.innerHTML='';
  TRADE_ROWS.forEach(r=>{
    const tr=document.createElement('tr');
    tr.innerHTML=`<td>${r.mes}</td><td>${r.parceiro}</td><td>${r.produto}</td><td>${r.acao}</td><td>${fmtBRL(r.valor)}</td><td>${r.objetivo}</td>`;
    tbody.appendChild(tr);
  });
  const mesSel=document.getElementById('fltMes'), parSel=document.getElementById('fltParceiro'), prodSel=document.getElementById('fltProduto');
  [...new Set(TRADE_ROWS.map(r=>r.mes))].forEach(m=>mesSel.insertAdjacentHTML('beforeend',`<option value="${m}">${m}</option>`));
  [...new Set(TRADE_ROWS.map(r=>r.parceiro))].forEach(p=>parSel.insertAdjacentHTML('beforeend',`<option value="${p}">${p}</option>`));
  [...new Set(TRADE_ROWS.map(r=>r.produto))].forEach(p=>prodSel.insertAdjacentHTML('beforeend',`<option value="${p}">${p}</option>`));
  const dt = $('#tableAudit').DataTable({pageLength:10, lengthChange:false, language:{search:'Buscar:', paginate:{previous:'‹',next:'›'}, info:'_START_–_END_ de _TOTAL_'}});
  mesSel.addEventListener('change', ()=>dt.column(0).search(mesSel.value).draw());
  parSel.addEventListener('change', ()=>dt.column(1).search(parSel.value).draw());
  prodSel.addEventListener('change', ()=>dt.column(2).search(prodSel.value).draw());
});
function exportAuditExcel(){
  const rows = TRADE_ROWS.map(r=>({Mes:r.mes, Parceiro:r.parceiro, Produto:r.produto, Acao:r.acao, Investimento:r.valor, Objetivo:r.objetivo}));
  const ws = XLSX.utils.json_to_sheet(rows);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Trade Digital');
  XLSX.writeFile(wb, 'condres_trade_digital_auditoria.xlsx');
}
function exportAuditCSV(){
  const header = ['Mes','Parceiro','Produto','Acao','Investimento','Objetivo'];
  const lines = [header.join(';')].concat(TRADE_ROWS.map(r=>[r.mes,r.parceiro,r.produto,r.acao,r.valor,r.objetivo.replace(/;/g,',')].join(';')));
  const blob = new Blob([lines.join('\n')], {type:'text/csv;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='condres_trade_digital_auditoria.csv'; a.click();
  URL.revokeObjectURL(url);
}

/* ---------- Log de Ativações ---------- */
function buildLogRows(){
  return TRADE_ROWS.map(r=>({data:r.mes, parceiro:r.parceiro, tipo:r.acao, produto:r.produto, valor:r.valor, objetivo:r.objetivo}));
}
function buildLogTable(){
  const rows = buildLogRows();
  const tbody=document.querySelector('#tableLog tbody'); tbody.innerHTML='';
  rows.forEach((r,idx)=>{
    const tr=document.createElement('tr'); tr.style.cursor='pointer';
    tr.innerHTML=`<td>${r.data}</td><td>${r.parceiro}</td><td>${r.tipo}</td><td>${r.produto}</td><td>${fmtBRL(r.valor)}</td><td>${r.objetivo}</td>`;
    tr.addEventListener('click', ()=>openLogModal(r));
    tbody.appendChild(tr);
  });
  $('#tableLog').DataTable({pageLength:10, lengthChange:false, language:{search:'Buscar:', paginate:{previous:'‹',next:'›'}, info:'_START_–_END_ de _TOTAL_'}});
}
function openLogModal(r){
  document.getElementById('logModalTitle').textContent = r.tipo+' · '+r.data;
  document.getElementById('logModalBody').innerHTML = `
    <div class="stat-row"><span>Parceiro</span><span>${r.parceiro}</span></div>
    <div class="stat-row"><span>Produto</span><span>${r.produto}</span></div>
    <div class="stat-row"><span>Investimento</span><span>${fmtBRL(r.valor)}</span></div>
    <div class="mini-label">Objetivo</div><p class="mini-text">${r.objetivo}</p>
    <span class="badge-confirmed">registro real — Mídia_-_Trade.xlsx</span>`;
  new bootstrap.Modal(document.getElementById('logModal')).show();
}

