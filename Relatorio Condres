<style>
:root{
  --navy:#003366; --navy-deep:#001B3A; --ems-blue:#0072CE; --white:#FFFFFF;
  --gray-bg:#F2F5F8; --gray-line:#DCE3EA; --gray-mid:#68798C; --text:#152238;
  --emerald:#00875A; --emerald-soft:#E4F5EE; --red:#B3453A; --red-soft:#FBEBE9; --amber:#C88A1F;
  --shadow: 0 2px 14px rgba(0,27,58,0.08); --shadow-lg: 0 12px 40px rgba(0,27,58,0.16);
}
*{box-sizing:border-box;}
body{font-family:'Inter',sans-serif; background:var(--gray-bg); color:var(--text); margin:0; -webkit-font-smoothing:antialiased;}
.display,.kpi-value,.section-title,.headline-text{font-family:'Sora',sans-serif;}
.sidebar{position:fixed; top:0; left:0; bottom:0; width:256px; background:linear-gradient(180deg,var(--navy-deep) 0%,var(--navy) 100%); color:#DCE6F2; z-index:1000; display:flex; flex-direction:column; padding:22px 0 16px;}
.sidebar .brand{padding:0 22px 18px; border-bottom:1px solid rgba(255,255,255,0.12); margin-bottom:10px;}
.sidebar .brand .tag{font-size:11px; letter-spacing:1.5px; text-transform:uppercase; color:#7FA8D9; font-weight:600;}
.sidebar .brand h1{font-size:20px; font-weight:700; color:#fff; margin:4px 0 0; font-family:'Sora',sans-serif;}
.nav-scroll{flex:1; overflow-y:auto;}
.side-link{display:flex; align-items:center; gap:9px; padding:9px 22px; font-size:12.8px; font-weight:500; color:#B9CBE2; cursor:pointer; border-left:3px solid transparent; transition:.15s;}
.side-link .num{font-family:'Sora',sans-serif; font-size:10.5px; color:#5F84B2; width:18px;}
.side-link:hover{background:rgba(255,255,255,0.06); color:#fff;}
.side-link.active{background:rgba(0,114,206,0.22); border-left-color:var(--ems-blue); color:#fff;}
.sidebar-foot{padding:12px 22px 0; border-top:1px solid rgba(255,255,255,0.1); margin-top:8px;}
.sidebar-foot small{color:#7691B3; font-size:10.5px; line-height:1.5; display:block;}
.main{margin-left:256px; padding:26px 34px 60px; max-width:1520px;}
.topbar{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px; gap:16px; flex-wrap:wrap;}
.topbar h2{font-size:23px; font-weight:700; margin:0;}
.topbar p{color:var(--gray-mid); font-size:13.3px; margin:4px 0 0;}
.export-bar .btn{font-size:12.5px; padding:7px 13px; border-radius:7px; font-weight:600;}
.btn-outline-navy{border:1px solid var(--navy); color:var(--navy); background:#fff;}
.btn-outline-navy:hover{background:var(--navy); color:#fff;}
.section{display:none;}
.section.active{display:block; animation:fadeUp .4s ease;}
@keyframes fadeUp{from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);}}
.section-sub{color:var(--gray-mid); font-size:13px; margin-bottom:18px;}
.card-panel{background:#fff; border-radius:14px; box-shadow:var(--shadow); padding:22px; border:1px solid var(--gray-line);}
.kpi-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:14px; margin-bottom:22px;}
.kpi-card{background:#fff; border-radius:14px; padding:18px 18px 16px; box-shadow:var(--shadow); border:1px solid var(--gray-line); cursor:pointer; transition:.2s; position:relative; overflow:hidden;}
.kpi-card:hover{transform:translateY(-3px); box-shadow:var(--shadow-lg); border-color:var(--ems-blue);}
.kpi-card::after{content:"›"; position:absolute; top:14px; right:16px; color:var(--gray-line); font-size:18px; font-weight:700;}
.kpi-label{font-size:11.3px; text-transform:uppercase; letter-spacing:.6px; color:var(--gray-mid); font-weight:600;}
.kpi-value{font-size:25px; font-weight:700; color:var(--navy); margin-top:6px;}
.kpi-value.positive{color:var(--emerald);}
.kpi-sub{font-size:11.3px; color:var(--gray-mid); margin-top:4px;}
.headline-banner{background:linear-gradient(120deg,var(--navy) 0%,#00478C 100%); color:#fff; border-radius:14px; padding:22px 26px; margin-bottom:22px; display:flex; align-items:center; gap:18px; box-shadow:var(--shadow-lg);}
.headline-banner .icon-badge{width:44px; height:44px; border-radius:12px; background:rgba(255,255,255,.14); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;}
.headline-banner .headline-text{font-size:16.3px; line-height:1.5; font-weight:500;}
.headline-banner b{color:#8FD9BE;}
.chart-box{background:#fff; border-radius:14px; box-shadow:var(--shadow); border:1px solid var(--gray-line); padding:18px 20px; margin-bottom:18px;}
.chart-box h5{font-size:14.3px; font-weight:700; margin-bottom:2px;}
.chart-box .chart-note{font-size:12px; color:var(--gray-mid); margin-bottom:12px;}
.chart-canvas-wrap{position:relative; height:320px;}
.chart-canvas-wrap.tall{height:400px;}
.badge-est{background:var(--gray-bg); color:var(--gray-mid); border:1px dashed #B7C4D1; font-size:10.3px; font-weight:600; padding:3px 8px; border-radius:20px;}
.badge-confirmed{background:var(--emerald-soft); color:var(--emerald); border:1px solid #B6E3D1; font-size:10.3px; font-weight:600; padding:3px 8px; border-radius:20px;}
.missing-note{display:flex; gap:10px; align-items:flex-start; background:#FFF8ED; border:1px solid #F0DDB0; border-radius:10px; padding:11px 14px; margin-bottom:14px; font-size:12.3px; color:#7A5A12;}
.missing-note .ico{font-size:15px; line-height:1.3;}
.missing-note b{color:#5C4200;}
.source-list{list-style:none; padding:0; margin:0;}
.source-list li{display:flex; gap:10px; align-items:flex-start; padding:8px 0; border-bottom:1px solid var(--gray-line); font-size:13.1px;}
.source-list li:last-child{border-bottom:none;}
.source-list li .chk{color:var(--emerald); font-weight:700; flex-shrink:0;}
.product-pill{display:flex; justify-content:space-between; align-items:center; padding:12px 16px; border-radius:10px; border:1px solid var(--gray-line); margin-bottom:8px; cursor:pointer; transition:.15s; background:#fff;}
.product-pill:hover{border-color:var(--ems-blue); background:#F7FAFD;}
.product-pill .name{font-weight:600; font-size:13.3px;}
.product-pill .grp{font-size:11px; color:var(--gray-mid);}
.product-pill .growth{font-family:'Sora',sans-serif; font-weight:700; font-size:14px;}
.growth.pos{color:var(--emerald);} .growth.neg{color:var(--red);}
.rede-pill{display:flex; justify-content:space-between; align-items:center; padding:12px 16px; border-radius:10px; border:1px solid var(--gray-line); margin-bottom:8px; cursor:pointer; transition:.15s; background:#fff;}
.rede-pill:hover{border-color:var(--ems-blue); background:#F7FAFD;}
.tl-card{background:#fff; border:1px solid var(--gray-line); border-radius:14px; padding:20px; cursor:pointer; transition:.2s; height:100%;}
.tl-card:hover{border-color:var(--ems-blue); box-shadow:var(--shadow-lg); transform:translateY(-2px);}
.modal-content{border-radius:16px; border:none;}
.modal-header{border-bottom:1px solid var(--gray-line);}
.modal-header .modal-title{font-family:'Sora',sans-serif; font-weight:700; color:var(--navy);}
.formula-box{background:var(--navy); color:#fff; font-family:'Sora',sans-serif; font-size:14.5px; padding:14px 16px; border-radius:10px; margin:12px 0;}
.mini-label{font-size:11px; text-transform:uppercase; letter-spacing:.6px; color:var(--gray-mid); font-weight:700; margin-top:14px; margin-bottom:4px;}
.mini-text{font-size:13.3px; line-height:1.6;}
.offcanvas-header{background:var(--navy); color:#fff;}
.offcanvas-header .btn-close{filter:invert(1);}
.stat-row{display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--gray-line); font-size:13.3px;}
.stat-row span:first-child{color:var(--gray-mid);}
.stat-row span:last-child{font-weight:700; font-family:'Sora',sans-serif; text-align:right;}
.conclusion-box{background:#fff; border-left:4px solid var(--ems-blue); border-radius:0 14px 14px 0; padding:22px 26px; box-shadow:var(--shadow);}
.appendix-item{border-bottom:1px solid var(--gray-line); padding:16px 0;}
.appendix-item:last-child{border-bottom:none;}
.appendix-item h6{font-weight:700; color:var(--navy); margin-bottom:6px;}
.filter-bar{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px;}
.filter-bar select{border:1px solid var(--gray-line); border-radius:8px; padding:7px 10px; font-size:12.8px; background:#fff;}
table.dataTable{font-size:12.6px;}
table.dataTable thead th{background:var(--navy); color:#fff; border-bottom:none !important;}
.insight-box{background:var(--emerald-soft); border:1px solid #B6E3D1; border-radius:12px; padding:16px 20px; margin-top:14px; font-size:13.3px; color:#1B4332;}
.insight-box b{color:var(--emerald);}
.corr-card{text-align:center; padding:20px; background:#fff; border:1px solid var(--gray-line); border-radius:14px;}
.corr-card .r{font-family:'Sora',sans-serif; font-size:36px; font-weight:800;}
.corr-card .r.pos{color:var(--emerald);} .corr-card .r.neg{color:var(--red);}
@media (max-width:900px){.sidebar{width:66px;} .sidebar .brand h1,.side-link span.label,.sidebar-foot{display:none;} .main{margin-left:66px;}}
</style>
</head>
