<nav class="sidebar">
  <div class="brand"><img src="data:image/png;base64," alt="EMS Digital" style="max-width:130px; height:auto; display:block; margin-bottom:10px;"><div class="tag">Resumo Executivo &middot; ROAS Digital</div><h1>Condres</h1></div>
