function monthLabels(){
  const meses=['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const labels=[]; for(let y=25;y<=26;y++){ for(let m=0;m<12;m++){ if(y===26&&m>8) break; labels.push(meses[m]+'/'+y);} } return labels;
}
function indexSeries(finalPct, months){
  const arr=[100]; const step=finalPct/(months-1);
  for(let i=1;i<months;i++){ arr.push(+(100+step*i + (Math.sin(i/2)*1.1)).toFixed(1)); }
  arr[arr.length-1]=+(100+finalPct).toFixed(1); return arr;
}
